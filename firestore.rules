rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // غيّر الإيميل ده لإيميل الأدمن اللي عملته في Authentication
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'PUT_YOUR_ADMIN_EMAIL_HERE';
    }

    // إعدادات الموقع والباقات: أي زائر يقرأ، والأدمن بس يعدّل
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الطلبات: الزائر يضيف طلب جديد بس بشكل محدد، والأدمن بس يقرأ ويعدّل ويمسح
    match /orders/{orderId} {
      allow create: if validOrder(orderId);
      allow read, update, delete: if isAdmin();
    }

    function validOrder(orderId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'cu', 'ph', 'biz', 'ty', 'pk', 'det', 'st', 'd'])
        && d.keys().hasAll(['id', 'cu', 'ph', 'biz', 'ty', 'pk', 'st', 'd'])
        && d.id is string && d.id == orderId
        && d.cu is string && d.cu.size() > 0 && d.cu.size() <= 100
        && d.ph is string && d.ph.size() >= 10 && d.ph.size() <= 25
        && d.biz is string && d.biz.size() > 0 && d.biz.size() <= 100
        && d.ty is string && d.ty.size() <= 20
        && d.pk is string && d.pk.size() <= 40
        && (!('det' in d) || (d.det is string && d.det.size() <= 1000))
        && d.st == 'new'
        && d.d is string && d.d.size() <= 40;
    }
  }
}
